{
  "name": "travel-map-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.8",
  "volta": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:env": "node scripts/check-env.mjs",
    "check:env-boundaries": "node scripts/check-env-boundaries.mjs",
    "ci": "npm run check:env && npm run check:env-boundaries && npm run lint && npm run typecheck && npm test && npm run build",
    "supabase:version": "supabase --version",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "supabase:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
